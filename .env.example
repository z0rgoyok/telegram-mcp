# Get these from https://my.telegram.org/apps
API_ID=
API_HASH=
# Phone number with country code, e.g. +79001234567
PHONE=
# Optional: how many dialogs to scan when filtering/searching chats
DIALOG_SCAN_LIMIT=1000
# Optional: maximum attachment payload for get_message_media (bytes)
MEDIA_DOWNLOAD_LIMIT_BYTES=8388608
# Optional: media proxy bind address and public URL for clients
MEDIA_PROXY_HOST=0.0.0.0
MEDIA_PROXY_PORT=8902
MEDIA_PROXY_PUBLIC_BASE_URL=http://localhost:8902
# Optional: signing secret for media proxy URLs (defaults to API_HASH if empty)
MEDIA_PROXY_TOKEN_SECRET=
# Optional: signed media URL TTL in seconds
MEDIA_PROXY_TOKEN_TTL_SECONDS=3600
